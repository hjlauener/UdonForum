# Kopiere diese Datei nach deploy.env und passe die Werte an.
# deploy.env wird nicht ins Git eingecheckt.

# Pfad zum ILIAS-Hauptverzeichnis (dort, wo cli/setup.php liegt).
# Bei Docker: der Pfad INNERHALB des Containers.
ILIAS_ROOT="/var/www/html/ilias"

# Optional: Name des Docker-Containers, in dem ILIAS läuft.
# Leer lassen, wenn ILIAS direkt auf diesem Rechner läuft.
DOCKER_CONTAINER=""

# Optional: Benutzer des Webservers, dem die Dateien gehören sollen
# (z. B. www-data unter Linux/Docker, _www unter macOS). Leer = nichts ändern.
WEB_USER=""

# true, wenn für Schreibzugriffe im ILIAS-Verzeichnis sudo nötig ist (nur lokal).
USE_SUDO="false"

# Optional: eigene Pfade zu PHP und Composer.
PHP_BIN="php"
COMPOSER_BIN="composer"
